# Server port
PORT=5000

# MongoDB Atlas connection string.
# Leave blank to boot the API without persistence (health will report db: "disconnected").
MONGO_URI=

# Allowed frontend origin for CORS
CLIENT_URL=http://localhost:5173

# Cloudinary photo uploads (Phase 3). Leave blank to run without photo upload —
# POST /api/uploads/image then answers 503 CLOUDINARY_NOT_CONFIGURED and the
# report wizard treats photos as optional.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email dispatch (Phase 5). SMTP_HOST empty → emails are SIMULATED (full
# preview stored in dispatchLog, counts as success).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Samadhan <no-reply@samadhan.local>
# Safe real-SMTP testing: redirect every escalation email to THIS address.
DISPATCH_OVERRIDE_TO=

# Optional n8n hook (Phase 5). Empty → webhook steps are SKIPPED.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Lifecycle cron (Phase 5). false disables all scheduled jobs.
ENABLE_CRON=true

# Phase 6 — official amplification. All optional; missing credentials make
# posts SIMULATED (full preview stored) instead of FAILED.
PUBLIC_SHARE_BASE_URL=http://localhost:5000
DEFAULT_SOCIAL_IMAGE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
BUFFER_API_KEY=
BUFFER_CHANNEL_X=
BUFFER_CHANNEL_FB=
BUFFER_CHANNEL_IG=
BUFFER_POST_MODE=shareNow
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REDDIT_SUBREDDIT=
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=samadhan-prototype/1.0
