{
  "name": "samadhan-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Samadhan API — Phase 0 foundation (Express + Mongoose + Zod)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/seed/admin.seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:authorities": "node src/seed/authorities.seed.js",
    "demo:on": "node src/scripts/demo-mode.js on",
    "demo:off": "node src/scripts/demo-mode.js off",
    "job:autoclose": "node src/scripts/run-autoclose.js",
    "seed:helpers": "node src/seed/seedHelpers.js",
    "seed:demo": "node src/seed/seedDemo.js",
    "demo:reset": "node src/seed/authorities.seed.js && node src/seed/seedDemo.js --reset && node src/seed/seedHelpers.js && node src/seed/seedDemo.js && node src/scripts/demo-mode.js on && node src/scripts/verify-data.js",
    "verify:data": "node src/scripts/verify-data.js",
    "check:env": "node scripts/check-env-example.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "verify": "npm test && npm run check:env && npm run check:secrets"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,json",
    "ignore": [
      "src/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.13.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  }
}
